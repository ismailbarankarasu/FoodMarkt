<header class="admin-header">

    <div class="header-left">

        <button type="button"
                class="sidebar-toggle"
                id="sidebarToggle">

            <i class="bi bi-list"></i>

        </button>



    </div>


    <div class="header-right">

        <div class="header-date">

            <div class="header-action-icon">
                <i class="bi bi-calendar3"></i>
            </div>

            <div>
                <span class="header-small-text">Bugün</span>
                <strong>@DateTime.Now.ToString("dd MMM yyyy")</strong>
            </div>

        </div>





        <div class="admin-profile">

            <div class="profile-avatar">
                <i class="bi bi-person"></i>
            </div>

            <div class="profile-info">
                <strong>@User.Identity?.Name</strong>
                <span>@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</span>
            </div>

            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="admin-btn" title="Çıkış yap">Çıkış yap</button>
            </form>

        </div>

    </div>

</header>