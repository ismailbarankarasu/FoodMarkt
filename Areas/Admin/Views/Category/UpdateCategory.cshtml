@model FoodMart.Dtos.CategoryDtos.UpdateCategoryDto

@{
    ViewData["Title"] = "Kategori Güncelle";
}

<div class="page-header">

    <div class="page-title-area">
        <h1>Kategori Güncelle</h1>
        <p>Seçilen kategorinin bilgilerini düzenleyebilirsiniz.</p>
    </div>

    <a asp-area="Admin"
       asp-controller="Category"
       asp-action="Index"
       class="admin-btn admin-btn-secondary">

        <i class="bi bi-arrow-left"></i>
        Kategorilere Dön

    </a>

</div>


<div class="form-page-grid">

    <div class="admin-card form-card">

        <div class="form-card-header">

            <div class="form-header-icon">
                <i class="bi bi-pencil-square"></i>
            </div>

            <div>
                <h3>Kategori Bilgileri</h3>
                <p>Kategori adı ve ikon bilgisini güncelleyin.</p>
            </div>

        </div>


        <form method="post">

            <input type="hidden" asp-for="Id" />

            <div class="admin-form-group">

                <label asp-for="Name">
                    Kategori Adı
                </label>

                <div class="admin-input-wrapper">

                    <i class="bi bi-tag"></i>

                    <input asp-for="Name"
                           class="admin-form-control"
                           placeholder="Örn: Meyve ve Sebzeler" />

                </div>

            </div>


            <div class="admin-form-group">

                <label asp-for="Icon">
                    İkon
                </label>

                <div class="admin-input-wrapper">

                    <i class="bi bi-stars"></i>

                    <input asp-for="Icon"
                           class="admin-form-control"
                           placeholder="Örn: icon-vegetables-broccoli" />

                </div>

                <span class="admin-form-hint">
                    Ana sayfadaki kategori kartında kullanılacak ikon sınıfını girin.
                </span>

            </div>


            <div class="form-actions">

                <a asp-area="Admin"
                   asp-controller="Category"
                   asp-action="Index"
                   class="admin-btn admin-btn-secondary">

                    Vazgeç

                </a>

                <button type="submit"
                        class="admin-btn admin-btn-primary">

                    <i class="bi bi-check-lg"></i>
                    Değişiklikleri Kaydet

                </button>

            </div>

        </form>

    </div>


    <div class="admin-card form-info-card">

        <div class="form-info-icon">
            <i class="bi bi-lightbulb"></i>
        </div>

        <h3>Kategori Yönetimi</h3>

        <p>
            Kategori bilgilerinde yaptığınız değişiklikler
            FoodMart mağazasında kullanılacaktır.
        </p>

        <div class="info-list">

            <div>
                <i class="bi bi-check-circle-fill"></i>
                <span>Açıklayıcı bir kategori adı kullanın.</span>
            </div>

            <div>
                <i class="bi bi-check-circle-fill"></i>
                <span>Kategoriye uygun bir ikon seçin.</span>
            </div>

            <div>
                <i class="bi bi-check-circle-fill"></i>
                <span>Değişiklikleri kaydetmeden önce kontrol edin.</span>
            </div>

        </div>

    </div>

</div>