@model FoodMart.Dtos.CategoryDtos.CreateCategoryDto

@{
    ViewData["Title"] = "Yeni Kategori";
}

<div class="page-header">

    <div class="page-title-area">
        <h1>Yeni Kategori</h1>
        <p>FoodMart mağazanız için yeni bir ürün kategorisi oluşturun.</p>
    </div>

    <a asp-area="Admin"
       asp-controller="Category"
       asp-action="Index"
       class="admin-btn admin-btn-secondary">

        <i class="bi bi-arrow-left"></i>
        Kategorilere Dön

    </a>

</div>


<div class="form-page-grid">

    <div class="admin-card form-card">

        <div class="form-card-header">

            <div class="form-header-icon">
                <i class="bi bi-plus-lg"></i>
            </div>

            <div>
                <h3>Kategori Bilgileri</h3>
                <p>Yeni kategorinin temel bilgilerini girin.</p>
            </div>

        </div>


        <form method="post">
            <div asp-validation-summary="All" class="admin-validation" role="alert"></div>

            <div class="admin-form-group">

                <label asp-for="Name">
                    Kategori Adı
                </label>

                <div class="admin-input-wrapper">

                    <i class="bi bi-tag"></i>

                    <input asp-for="Name"
                           class="admin-form-control"
                           placeholder="Örn: Meyve ve Sebzeler" />

                </div>

            </div>


            <div class="admin-form-group">

                <label asp-for="Icon">
                    İkon
                </label>

                <div class="admin-input-wrapper">

                    <i class="bi bi-stars"></i>

                    <input asp-for="Icon"
                           class="admin-form-control"
                           placeholder="Örn: icon-vegetables-broccoli" />

                </div>

                <span class="admin-form-hint">
                    Temadaki kategori ikon sınıfını girebilirsiniz.
                </span>

            </div>


            <div class="form-actions">

                <a asp-area="Admin"
                   asp-controller="Category"
                   asp-action="Index"
                   class="admin-btn admin-btn-secondary">

                    Vazgeç

                </a>

                <button type="submit"
                        class="admin-btn admin-btn-primary">

                    <i class="bi bi-plus-lg"></i>
                    Kategori Oluştur

                </button>

            </div>

        </form>

    </div>


    <div class="admin-card form-info-card">

        <div class="form-info-icon">
            <i class="bi bi-lightbulb"></i>
        </div>

        <h3>Küçük bir ipucu</h3>

        <p>
            Kategoriler, ziyaretçilerin ürünlere daha hızlı
            ulaşmasını sağlar.
        </p>

        <div class="info-list">

            <div>
                <i class="bi bi-check-circle-fill"></i>
                <span>Kısa ve anlaşılır kategori adları kullanın.</span>
            </div>

            <div>
                <i class="bi bi-check-circle-fill"></i>
                <span>Kategoriyi temsil eden uygun bir ikon seçin.</span>
            </div>

        </div>

    </div>

</div>