@using System.Text.Json
@using FoodMart.Dtos.DashboardDtos
@model DashboardDto

@{
    ViewData["Title"] = "Dashboard";

    var salesChartData = Model.Last7DaysSales
        .Select(x => new
        {
            label = x.Date.ToLocalTime().ToString("dd.MM"),
            sales = x.TotalQuantitySold,
            revenue = x.TotalRevenue
        });

    var categoryChartData = Model.CategorySales
        .Select(x => new
        {
            label = x.CategoryName,
            value = x.TotalQuantitySold
        });
}
<script id="dashboardSalesData" type="application/json">
    @Html.Raw(JsonSerializer.Serialize(salesChartData))
</script>

<script id="dashboardCategoryData" type="application/json">
    @Html.Raw(JsonSerializer.Serialize(categoryChartData))
</script>
<div class="page-header">
    <div class="page-title-area">
        <h1>Dashboard</h1>
        <p>FoodMart mağazanızın performansını ve güncel durumunu buradan takip edebilirsiniz.</p>
    </div>

    <div class="dashboard-date-badge">
        <i class="bi bi-calendar-check"></i>
        <span>@DateTime.Now.ToString("dd MMMM yyyy")</span>
    </div>
</div>

<!-- KPI CARDS -->
<div class="stats-grid">

    <div class="stat-card">
        <div class="stat-card-top">
            <div class="stat-icon stat-icon-green">
                <i class="bi bi-box-seam"></i>
            </div>
        </div>

        <div class="stat-content">
            <span class="stat-label">Toplam Ürün</span>

            <h3>@Model.TotalProducts</h3>

            <p>
                Bu ay
                <strong>@Model.NewProductsThisMonth yeni ürün</strong>
                eklendi
            </p>
        </div>
    </div>


    <div class="stat-card">
        <div class="stat-card-top">
            <div class="stat-icon stat-icon-blue">
                <i class="bi bi-bag-check"></i>
            </div>
        </div>

        <div class="stat-content">
            <span class="stat-label">Toplam Satış</span>

            <h3>@Model.TotalSalesQuantity.ToString("N0")</h3>

            <p>
                Bu ay
                <strong>@Model.SalesThisMonth adet ürün</strong>
                satıldı
            </p>
        </div>
    </div>


    <div class="stat-card">
        <div class="stat-card-top">
            <div class="stat-icon stat-icon-orange">
                <i class="bi bi-currency-dollar"></i>
            </div>
        </div>

        <div class="stat-content">
            <span class="stat-label">Toplam Gelir</span>

            <h3>₺@Model.TotalRevenue.ToString("N2")</h3>

            <p>
                Bu ay
                <strong>₺@Model.RevenueThisMonth.ToString("N2")</strong>
                gelir elde edildi
            </p>
        </div>
    </div>


    <div class="stat-card">
        <div class="stat-card-top">
            <div class="stat-icon stat-icon-purple">
                <i class="bi bi-envelope-heart"></i>
            </div>
        </div>

        <div class="stat-content">
            <span class="stat-label">Bülten Abonesi</span>

            <h3>@Model.TotalSubscribers.ToString("N0")</h3>

            <p>
                Son 7 günde
                <strong>+@Model.NewSubscribersLast7Days yeni abone</strong>
            </p>
        </div>
    </div>

</div>

<!-- CHARTS -->
<div class="dashboard-chart-grid">

    <div class="admin-card dashboard-chart-card">

        <div class="card-heading">
            <div>
                <h3>Satış Performansı</h3>
                <p>Son 7 günlük satış ve gelir hareketleri</p>
            </div>

            <div class="chart-legend-custom">
                <span>
                    <i class="legend-dot sales-dot"></i>
                    Satış
                </span>

                <span>
                    <i class="legend-dot revenue-dot"></i>
                    Gelir
                </span>
            </div>
        </div>

        <div class="chart-container">
            <canvas id="salesChart"></canvas>
        </div>

    </div>


    <div class="admin-card dashboard-chart-card">

        <div class="card-heading">
            <div>
                <h3>Kategori Dağılımı</h3>
                <p>Satışların kategori bazlı dağılımı</p>
            </div>

            <button class="card-more-button">
                <i class="bi bi-three-dots"></i>
            </button>
        </div>

        <div class="donut-container">
            <canvas id="categoryChart"></canvas>

            <div class="donut-center">
                <strong>@Model.TotalSalesQuantity.ToString("N0")</strong>
                <span>Satış</span>
            </div>
        </div>

        <div class="category-chart-legend">

            @{
                var totalCategorySales =
                    Model.CategorySales.Sum(x => x.TotalQuantitySold);

                var categoryIndex = 0;
            }

            @foreach (var category in Model.CategorySales.Take(4))
            {
                var percentage = totalCategorySales > 0
                    ? Math.Round(
                        (decimal)category.TotalQuantitySold /
                        totalCategorySales * 100,
                        1)
                    : 0;

                var colorClass = categoryIndex switch
                {
                    0 => "category-one",
                    1 => "category-two",
                    2 => "category-three",
                    _ => "category-four"
                };

                <div>
                    <span class="category-color @colorClass"></span>

                    @category.CategoryName

                    <strong>%@percentage</strong>
                </div>

                categoryIndex++;
            }

        </div>

    </div>

</div>

<!-- TABLE + POPULAR PRODUCTS -->
<div class="dashboard-bottom-grid">

    <div class="admin-card">

        <div class="card-heading table-heading">
            <div>
                <h3>Son Satışlar</h3>
                <p>Gerçekleştirilen son satış işlemleri</p>
            </div>

            <a asp-area="Admin"
               asp-controller="Sale"
               asp-action="Index"
               class="view-all-link">
                Tümünü Gör
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="admin-table-wrapper">
            <table class="admin-table">

                <thead>
                    <tr>
                        <th>Ürün</th>
                        <th>Adet</th>
                        <th>Tarih</th>
                        <th>Tutar</th>
                        <th>Durum</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.RecentSales.Any())
                    {
                        foreach (var sale in Model.RecentSales)
                        {
                            <tr>
                                <td>
                                    <div class="table-product">

                                        <div class="table-product-icon">
                                            <i class="bi bi-basket"></i>
                                        </div>

                                        <div>
                                            <strong>@sale.ProductName</strong>

                                            <span>
                                                #@sale.Id[^6..].ToUpper()
                                            </span>
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    @sale.Quantity adet
                                </td>

                                <td>
                                    @sale.SaleDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </td>

                                <td>
                                    <strong>
                                        ₺@sale.TotalPrice.ToString("N2")
                                    </strong>
                                </td>

                                <td>
                                    <span class="status-badge success">
                                        Tamamlandı
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">

                                <div class="empty-state">

                                    <div class="empty-state-icon">
                                        <i class="bi bi-bag-x"></i>
                                    </div>

                                    <strong>Henüz satış bulunmuyor</strong>

                                    <p>
                                        Yeni satışlar eklendiğinde burada
                                        görüntülenecektir.
                                    </p>

                                </div>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        </div>

    </div>


    <div class="admin-card popular-card">

        <div class="card-heading">
            <div>
                <h3>Çok Satan Ürünler</h3>
                <p>En yüksek satış adedine sahip ürünler</p>
            </div>
        </div>

        <div class="popular-product-list">

            @if (Model.PopularProducts.Any())
            {
                var rank = 1;

                foreach (var product in Model.PopularProducts)
                {
                    <div class="popular-product">

                        <div class="popular-rank">
                            @rank.ToString("D2")
                        </div>

                        <div class="popular-product-image">

                            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl"
                                     alt="@product.ProductName"
                                     style="width:100%; height:100%; object-fit:cover; border-radius:10px;" />
                            }
                            else
                            {
                                <i class="bi bi-box-seam"></i>
                            }

                        </div>

                        <div class="popular-product-info">

                            <strong>
                                @product.ProductName
                            </strong>

                            <span>
                                @product.CategoryName
                            </span>

                        </div>

                        <div class="popular-product-sales">

                            <strong>
                                @product.TotalQuantitySold
                            </strong>

                            <span>satış</span>

                        </div>

                    </div>

                    rank++;
                }
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-state-icon">
                        <i class="bi bi-bar-chart"></i>
                    </div>

                    <strong>Satış verisi bulunmuyor</strong>

                    <p>
                        Ürün satışları eklendiğinde çok satan
                        ürünler burada görüntülenecektir.
                    </p>

                </div>
            }

        </div>

    </div>

</div>

<!-- QUICK ACTIONS -->
<div class="admin-card quick-actions-card">

    <div class="card-heading">
        <div>
            <h3>Hızlı İşlemler</h3>
            <p>Sık kullandığınız yönetim işlemlerine hızlıca ulaşın</p>
        </div>
    </div>

    <div class="quick-actions">

        <a asp-area="Admin"
           asp-controller="Category"
           asp-action="CreateCategory"
           class="quick-action">

            <div class="quick-action-icon green">
                <i class="bi bi-tag"></i>
            </div>

            <div>
                <strong>Kategori Ekle</strong>
                <span>Yeni kategori oluştur</span>
            </div>

            <i class="bi bi-chevron-right"></i>
        </a>

        <a href="#" class="quick-action">
            <div class="quick-action-icon blue">
                <i class="bi bi-box-seam"></i>
            </div>

            <div>
                <strong>Ürün Ekle</strong>
                <span>Yeni ürün oluştur</span>
            </div>

            <i class="bi bi-chevron-right"></i>
        </a>

        <a asp-area="Admin"
           asp-controller="Discount"
           asp-action="CreateDiscount"
           class="quick-action">
            <div class="quick-action-icon orange">
                <i class="bi bi-percent"></i>
            </div>

            <div>
                <strong>İndirim Oluştur</strong>
                <span>Yeni kampanya tanımla</span>
            </div>

            <i class="bi bi-chevron-right"></i>
        </a>

        <a asp-area="Admin"
           asp-controller="Sale"
           asp-action="CreateSale"
           class="quick-action">
            <div class="quick-action-icon purple">
                <i class="bi bi-graph-up-arrow"></i>
            </div>

            <div>
                <strong>Satış Ekle</strong>
                <span>Yeni satış kaydı oluştur</span>
            </div>

            <i class="bi bi-chevron-right"></i>
        </a>

    </div>

</div>