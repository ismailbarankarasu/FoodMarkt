@model List<FoodMart.Dtos.ProductDtos.ResultProductDto>

@{
    ViewData["Title"] = ViewBag.CategoryName;

    var categoryName =
        ViewBag.CategoryName as string ?? "Kategori";
}

<section class="py-5">

    <div class="container-fluid">

        <div class="section-header d-flex flex-wrap justify-content-between align-items-center mb-5">

            <div>

                <div class="mb-2">

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="text-decoration-none text-muted">

                        Tüm Ürünler

                    </a>

                    <span class="mx-2">/</span>

                    <span>
                        @categoryName
                    </span>

                </div>

                <h1 class="section-title mb-2">
                    @categoryName
                </h1>

                <p class="text-muted mb-0">
                    Bu kategorideki ürünleri keşfedin.
                </p>

            </div>

            <span class="text-muted">
                @Model.Count ürün
            </span>

        </div>


        @if (Model.Any())
        {
            <div class="row g-4">

                @foreach (var item in Model)
                {
                    var hasDiscount =
                        item.DiscountPrice.HasValue &&
                        item.DiscountPrice.Value > 0 &&
                        item.DiscountPrice.Value < item.Price;

                    var discountRate = 0;

                    if (hasDiscount && item.Price > 0)
                    {
                        discountRate = (int)Math.Round(
                            (1 - (item.DiscountPrice!.Value / item.Price)) * 100);
                    }

                    <div class="col-xl-3 col-lg-4 col-md-6">

                        <div class="product-item h-100">

                            @if (hasDiscount)
                            {
                                <span class="badge bg-success position-absolute m-3">
                                    -%@discountRate
                                </span>
                            }

                            <figure>

                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.Id" title="@item.Name">

                                    <img src="@item.ImageUrl"
                                         alt="@item.Name"
                                         class="tab-image" />

                                </a>

                            </figure>

                            <h3>
                                @item.Name
                            </h3>

                            <div class="mb-2">

                                <span class="qty">
                                    @item.CategoryName
                                </span>

                            </div>

                            @if (item.Stock > 0)
                            {
                                <span class="text-success small">
                                    Stokta
                                </span>
                            }
                            else
                            {
                                <span class="text-danger small">
                                    Stokta Yok
                                </span>
                            }

                            <div class="mt-2 mb-3">

                                @if (hasDiscount)
                                {
                                    <span class="price">
                                        @item.DiscountPrice!.Value.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) ₺
                                    </span>

                                    <span class="text-muted text-decoration-line-through ms-2">
                                        @item.Price.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) ₺
                                    </span>
                                }
                                else
                                {
                                    <span class="price">
                                        @item.Price.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) ₺
                                    </span>
                                }

                            </div>

                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.Id" class="btn btn-outline-dark mt-3">Ürünü incele</a>
                            @if (item.Stock > 0)
                            {
                                <partial name="_AddToCartPartial" model="item.Id" />
                            }

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-box-seam fs-1 text-muted"></i>

                <h3 class="mt-3">
                    Bu kategoride ürün bulunamadı
                </h3>

                <p class="text-muted">
                    Bu kategoriye ait aktif bir ürün bulunmuyor.
                </p>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-primary mt-2">

                    Tüm Ürünleri Gör

                </a>

            </div>
        }

    </div>

</section>