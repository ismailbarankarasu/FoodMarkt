@model List<FoodMart.Dtos.ProductDtos.ResultProductDto>

@{
    ViewData["Title"] = "Ürün Ara";

    var searchTerm = ViewBag.SearchTerm as string ?? "";
}

<section class="py-5">
    <div class="container-fluid">

        <div class="row justify-content-center mb-5">
            <div class="col-lg-8">

                <div class="text-center mb-4">

                    <h2 class="section-title">
                        Ürün Ara
                    </h2>

                    <p class="text-muted">
                        Aradığınız ürünü hızlıca bulun.
                    </p>

                </div>

                <form asp-controller="Product"
                      asp-action="Search"
                      method="get">

                    <div class="input-group input-group-lg">

                        <input type="text"
                               name="search"
                               value="@searchTerm"
                               class="form-control"
                               placeholder="Ürün adı veya açıklama ara..."
                               autocomplete="off" />

                        <button type="submit"
                                class="btn btn-primary px-4">

                            <i class="bi bi-search"></i>
                            Ara

                        </button>

                    </div>

                </form>

            </div>
        </div>


        @if (Model.Any())
        {
            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h3 class="mb-1">
                        Arama Sonuçları
                    </h3>

                    <p class="text-muted mb-0">
                        @Model.Count ürün bulundu.
                    </p>
                </div>

            </div>
        }


        @if (Model.Any())
        {
            <div class="row g-4">

                @foreach (var item in Model)
                {
                    var hasDiscount =
                        item.DiscountPrice.HasValue &&
                        item.DiscountPrice.Value > 0 &&
                        item.DiscountPrice.Value < item.Price;

                    var discountRate = 0;

                    if (hasDiscount && item.Price > 0)
                    {
                        discountRate = (int)Math.Round(
                            (1 - (item.DiscountPrice!.Value / item.Price)) * 100);
                    }

                    <div class="col-xl-3 col-lg-4 col-md-6">

                        <div class="product-item h-100">

                            @if (hasDiscount)
                            {
                                <span class="badge bg-success position-absolute m-3">
                                    -%@discountRate
                                </span>
                            }

                            <a href="#"
                               class="btn-wishlist"
                               title="Favorilere Ekle">

                                <svg width="24" height="24">
                                    <use xlink:href="#heart"></use>
                                </svg>

                            </a>

                            <figure>

                                <a href="#"
                                   title="@item.Name">

                                    <img src="@item.ImageUrl"
                                         alt="@item.Name"
                                         class="tab-image" />

                                </a>

                            </figure>

                            <h3>
                                @item.Name
                            </h3>

                            <div class="mb-2">

                                <span class="qty">
                                    @item.CategoryName
                                </span>

                            </div>

                            @if (item.Stock > 0)
                            {
                                <span class="text-success small">
                                    Stokta
                                </span>
                            }
                            else
                            {
                                <span class="text-danger small">
                                    Stokta Yok
                                </span>
                            }

                            <div class="mt-2 mb-3">

                                @if (hasDiscount)
                                {
                                    <span class="price">
                                        @item.DiscountPrice!.Value.ToString("N2") ₺
                                    </span>

                                    <span class="text-muted text-decoration-line-through ms-2">
                                        @item.Price.ToString("N2") ₺
                                    </span>
                                }
                                else
                                {
                                    <span class="price">
                                        @item.Price.ToString("N2") ₺
                                    </span>
                                }

                            </div>

                            <div class="d-flex align-items-center justify-content-between">

                                <div class="input-group product-qty">

                                    <span class="input-group-btn">

                                        <button type="button"
                                                class="quantity-left-minus btn btn-danger btn-number">

                                            <svg width="16" height="16">
                                                <use xlink:href="#minus"></use>
                                            </svg>

                                        </button>

                                    </span>

                                    <input type="text"
                                           name="quantity"
                                           class="form-control input-number"
                                           value="1"
                                           min="1" />

                                    <span class="input-group-btn">

                                        <button type="button"
                                                class="quantity-right-plus btn btn-success btn-number">

                                            <svg width="16" height="16">
                                                <use xlink:href="#plus"></use>
                                            </svg>

                                        </button>

                                    </span>

                                </div>

                                <a href="#"
                                   class="nav-link">

                                    Sepete Ekle

                                    <iconify-icon icon="uil:shopping-cart">
                                    </iconify-icon>

                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            <div class="text-center py-5">

                <div class="mb-3">
                    <i class="bi bi-search fs-1 text-muted"></i>
                </div>

                <h3>
                    Ürün bulunamadı
                </h3>

                <p class="text-muted">
                    "<strong>@searchTerm</strong>"
                    aramasına uygun aktif bir ürün bulunamadı.
                </p>

                <a asp-controller="Default"
                   asp-action="Index"
                   class="btn btn-primary mt-2">

                    Ana Sayfaya Dön

                </a>

            </div>
        }

    </div>
</section>