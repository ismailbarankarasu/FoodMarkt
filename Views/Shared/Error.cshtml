@model ErrorViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bir sorun oluştu - FoodMart</title>
    <link rel="stylesheet" href="~/admin/css/custom-admin.css" />
</head>
<body>
    <main class="admin-content">
        <div class="admin-card empty-state">
            <h1>Bir sorun oluştu</h1>
            <p>İsteğiniz şu anda tamamlanamadı. Lütfen biraz sonra tekrar deneyiniz.</p>
            <p>Destek için işlem numarası: <code>@Model.RequestId</code></p>
            <a href="/" class="admin-btn admin-btn-primary">Ana sayfaya dön</a>
        </div>
    </main>
</body>
</html>
