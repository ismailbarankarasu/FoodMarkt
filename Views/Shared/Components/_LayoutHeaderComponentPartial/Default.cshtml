@model List<FoodMart.Dtos.CategoryDtos.ResultCategoryDto>
@{ var home = Url.Action("Index", "Default", new { area = "" }); }
<header class="storefront-header">
    <div class="container-fluid">
        <div class="row align-items-center gy-3 py-3 border-bottom">
            <div class="col-8 col-lg-3">
                <a asp-area="" asp-controller="Default" asp-action="Index" class="main-logo">
                    <img src="~/FoodMart-1.0.0/images/logo.png" alt="FoodMart ana sayfa" class="img-fluid" width="241" height="54" />
                </a>
            </div>
            <div class="col-lg-7 d-none d-lg-block">
                <form asp-area="" asp-controller="Product" asp-action="Search" method="get" role="search">
                    <div class="storefront-search bg-light rounded-4 p-2">
                        <label for="headerSearchCategory" class="visually-hidden">Aranacak kategori</label>
                        <select id="headerSearchCategory" name="categoryId" class="form-select border-0 bg-transparent">
                            <option value="">Tüm kategoriler</option>
                            @foreach (var category in Model)
                            {
                                <option value="@category.Id" selected="@(Context.Request.Query["categoryId"] == category.Id)">@category.Name</option>
                            }
                        </select>
                        <label for="headerSearch" class="visually-hidden">Ürün ara</label>
                        <input id="headerSearch" type="search" name="search" value="@Context.Request.Query["search"]" class="form-control border-0 bg-transparent" placeholder="Ürünlerde ara..." maxlength="150" />
                        <button type="submit" class="btn btn-primary" aria-label="Ürün ara"><svg width="22" height="22" aria-hidden="true"><use href="#search"></use></svg></button>
                    </div>
                </form>
            </div>
            <div class="col-4 col-lg-2 text-end">
                <a href="@(home + "#subscribe")" class="d-none d-lg-inline-block text-decoration-none">İndirim kodu al</a>
                <button type="button" class="btn btn-light d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#offcanvasSearch" aria-controls="offcanvasSearch" aria-label="Ürün aramasını aç"><svg width="24" height="24" aria-hidden="true"><use href="#search"></use></svg></button>
            </div>
        </div>
        <nav class="navbar navbar-expand-lg py-3" aria-label="Ana gezinme">
            <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-label="Menüyü aç"><span class="navbar-toggler-icon"></span></button>
            <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
                <div class="offcanvas-header">
                    <h2 class="h5" id="offcanvasNavbarLabel">Menü</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Menüyü kapat"></button>
                </div>
                <div class="offcanvas-body align-items-center gap-3">
                    <label class="visually-hidden" for="headerCategoryNavigation">Kategoriye git</label>
                    <select class="form-select storefront-category" id="headerCategoryNavigation">
                        <option value="@Url.Action("Index", "Product", new { area = "" })">Tüm ürünler</option>
                        @foreach (var category in Model)
                        {
                            <option value="@Url.Action("Category", "Product", new { area = "", id = category.Id })" selected="@(ViewBag.CategoryId as string == category.Id)">@category.Name</option>
                        }
                    </select>
                    <ul class="navbar-nav gap-lg-3">
                        <li class="nav-item"><a href="@(home + "#home")" class="nav-link">Ana Sayfa</a></li>
                        <li class="nav-item"><a href="@(home + "#categories")" class="nav-link">Kategoriler</a></li>
                        <li class="nav-item"><a href="@(home + "#products")" class="nav-link">Ürünler</a></li>
                        <li class="nav-item"><a href="@(home + "#discounts")" class="nav-link">Kampanyalar</a></li>
                        <li class="nav-item"><a href="@(home + "#popular-products")" class="nav-link">Çok Satanlar</a></li>
                        <li class="nav-item"><a href="@(home + "#contact")" class="nav-link">İletişim</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </div>
</header>
