@{ var home = Url.Action("Index", "Default", new { area = "" }); }
<footer id="contact" class="storefront-footer py-5" aria-labelledby="footerTitle">
    <div class="container-fluid">
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <h2 id="footerTitle" class="h4">FoodMart</h2>
                <p>Ürünleri, kategorileri ve güncel kampanyaları tek bir yerde keşfedin.</p>
                <p class="text-muted small">Bu mağaza bir portföy projesidir. Çevrim içi sipariş ve ödeme hizmeti sunulmaz.</p>
            </div>
            <div class="col-6 col-lg-2">
                <h3 class="h6">Hızlı Bağlantılar</h3>
                <ul class="list-unstyled footer-links">
                    <li><a href="@(home + "#home")">Ana Sayfa</a></li>
                    <li><a href="@(home + "#categories")">Kategoriler</a></li>
                    <li><a href="@(home + "#products")">Ürünler</a></li>
                    <li><a href="@(home + "#discounts")">Kampanyalar</a></li>
                    <li><a href="@(home + "#popular-products")">Çok Satanlar</a></li>
                </ul>
            </div>
            <div class="col-6 col-lg-3">
                <h3 class="h6">Müşteri Hizmetleri</h3>
                <ul class="list-unstyled footer-links">
                    <li><a asp-area="" asp-controller="Product" asp-action="Index">Ürünleri incele</a></li>
                    <li><a href="@(home + "#subscribe")">İndirim kodu kampanyası</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Gizlilik bilgileri</a></li>
                </ul>
            </div>
            <div class="col-md-6 col-lg-3">
                <h3 class="h6">İletişim</h3>
                <p>Proje hakkında bilgi ve geri bildirim için GitHub sayfasını ziyaret edebilirsiniz.</p>
                <a href="https://github.com/ismailbarankarasu/FoodMarkt">FoodMart proje sayfası</a>
            </div>
        </div>
        <div class="border-top mt-4 pt-3 d-flex flex-wrap justify-content-between gap-2 small">
            <span>© @DateTime.Now.Year FoodMart. Tüm hakları saklıdır.</span>
            <span>Tema tasarımı: <a href="https://templatesjungle.com/">TemplatesJungle</a></span>
        </div>
    </div>
</footer>
