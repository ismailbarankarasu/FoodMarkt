<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasSearch" aria-labelledby="mobileSearchTitle">
    <div class="offcanvas-header">
        <h2 class="h5" id="mobileSearchTitle">Ürün Ara</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Aramayı kapat"></button>
    </div>
    <div class="offcanvas-body">
        <form asp-area="" asp-controller="Product" asp-action="Search" method="get" role="search">
            <label for="mobileSearch" class="form-label">Ürün adı veya açıklama</label>
            <input id="mobileSearch" name="search" type="search" class="form-control mb-3" placeholder="Ne arıyorsunuz?" maxlength="150" value="@Context.Request.Query["search"]" />
            <input type="hidden" name="categoryId" value="@Context.Request.Query["categoryId"]" />
            <button class="btn btn-primary w-100" type="submit">Ara</button>
        </form>
    </div>
</div>
