@model List<FoodMart.Dtos.DiscountDtos.ResultDiscountDto>

@if (Model.Any())
{
    <section class="py-5">
        <div class="container-fluid">
            <div class="row">

                @for (var i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];

                    var backgroundClass = i % 2 == 0
                        ? "bg-danger"
                        : "bg-info";

                    <div class="col-md-6">

                        <div class="banner-ad @backgroundClass mb-3"
                             style="background-image: url('@item.ImageUrl');
                            background-repeat: no-repeat;
                            background-position: right bottom;
                            background-size: contain;">

                            <div class="banner-content p-5">

                                <div class="categories text-primary fs-3 fw-bold">
                                    %@item.DiscountRate İndirim
                                </div>

                                <h3 class="banner-title">
                                    @item.Title
                                </h3>

                                <p>
                                    @item.Description
                                </p>

                                <a href="#"
                                   class="btn btn-dark text-uppercase">
                                    Ürünü İncele
                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>
        </div>
    </section>
}