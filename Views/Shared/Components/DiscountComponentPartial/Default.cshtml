@model List<FoodMart.Dtos.DiscountDtos.ResultDiscountDto>
<section id="discounts" class="py-5">
    <div class="container-fluid">
        <h2 class="section-title mb-4">Güncel Kampanyalar</h2>
        @if (Model.Any())
        {
            <div class="row g-4">
                @for (var i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    <div class="col-md-6">
                        <article class="banner-ad campaign-card @(i % 2 == 0 ? "bg-danger" : "bg-info") h-100">
                            <div class="banner-content p-4">
                                <span class="categories text-primary fs-3 fw-bold">%@item.DiscountRate İndirim</span>
                                <h3 class="banner-title">@item.Title</h3>
                                <p>@item.Description</p>
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId" class="btn btn-dark">Ürünü incele</a>
                            </div>
                            <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" class="campaign-image" />
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">Şu anda aktif kampanya bulunmuyor. Yeni fırsatlar için tekrar ziyaret edin.</p>
        }
    </div>
</section>
