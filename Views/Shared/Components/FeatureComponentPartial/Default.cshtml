@model List<FoodMart.Dtos.FeatureDtos.ResultFeatureDto>
<section aria-label="Öne çıkanlar" class="py-3" style="background-image: url('/FoodMart-1.0.0/images/background-pattern.jpg');background-repeat: no-repeat;background-size: cover;">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">

                <div class="banner-blocks">

                    <div class="banner-ad large bg-info block-1">

                        <div class="swiper main-swiper">

                            <div class="swiper-wrapper">

                                @if (Model.Any())
                                {
                                    @foreach (var item in Model)
                                    {
                                        <div class="swiper-slide">

                                            <div class="row banner-content p-5">

                                                <div class="content-wrapper col-md-7">

                                                    <div class="categories my-3">
                                                        FoodMart
                                                    </div>

                                                    <h3 class="display-4">
                                                        @item.Title
                                                    </h3>

                                                    <p>
                                                        @item.Description
                                                    </p>

                                                    @if (!string.IsNullOrWhiteSpace(item.ButtonText) && FoodMart.Validators.FormRules.SafeUrl(item.ButtonUrl))
                                                    {
                                                        <a href="@Url.Content(item.ButtonUrl)"
                                                           class="btn btn-outline-dark btn-lg text-uppercase fs-6 rounded-1 px-4 py-3 mt-3">

                                                            @item.ButtonText

                                                        </a>
                                                    }

                                                </div>

                                                <div class="img-wrapper col-md-5">

                                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                                    {
                                                        <img src="@item.ImageUrl"
                                                             alt="@item.Title"
                                                             class="img-fluid" />
                                                    }

                                                </div>

                                            </div>

                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="swiper-slide">

                                        <div class="row banner-content p-5">

                                            <div class="content-wrapper col-md-7">

                                                <div class="categories my-3">
                                                    FoodMarkt
                                                </div>

                                                <h3 class="display-4">
                                                    FoodMarkt'a Hoş Geldiniz
                                                </h3>

                                                <p>
                                                    Taze ve kaliteli ürünleri keşfedin.
                                                </p>

                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>

                            @if (Model.Count > 1)
                            {
                                <div class="swiper-pagination"></div>
                            }

                        </div>

                    </div>

                    <div class="banner-ad bg-success-subtle block-2" style="background:url('/FoodMart-1.0.0/images/ad-image-1.png') no-repeat;background-position: right bottom">
                        <div class="row banner-content p-5">

                            <div class="content-wrapper col-md-7">
                                <div class="categories sale mb-3 pb-3">Taze seçenekler</div>
                                <h3 class="banner-title">Ürünlerimizi keşfedin</h3>
                                <a asp-controller="Product" asp-action="Index" class="d-flex align-items-center nav-link">Ürünleri incele <svg width="24" height="24"><use xlink:href="#arrow-right"></use></svg></a>
                            </div>

                        </div>
                    </div>

                    <div class="banner-ad bg-danger block-3" style="background:url('/FoodMart-1.0.0/images/ad-image-2.png') no-repeat;background-position: right bottom">
                        <div class="row banner-content p-5">

                            <div class="content-wrapper col-md-7">
                                <div class="categories sale mb-3 pb-3">Her gün taze</div>
                                <h3 class="item-title">Sofranız için</h3>
                                <a asp-controller="Product" asp-action="Index" class="d-flex align-items-center nav-link">Ürünleri incele <svg width="24" height="24"><use xlink:href="#arrow-right"></use></svg></a>
                            </div>

                        </div>
                    </div>

                </div>
                <!-- / Banner Blocks -->

            </div>
        </div>
    </div>
</section>