@model List<FoodMart.Dtos.ProductDtos.ResultProductDto>

<section class="py-5">
    <div class="container-fluid">

        <div class="row">
            <div class="col-md-12">

                <div class="section-header d-flex flex-wrap justify-content-between my-5">

                    <h2 class="section-title">
                        Son Eklenen Ürünler
                    </h2>

                    <div class="d-flex align-items-center">
                        <a asp-controller="Product"
                           asp-action="Index"
                           class="btn-link text-decoration-none">
                            Tüm Ürünleri Gör →
                        </a>
                    </div>

                </div>

            </div>
        </div>

        @if (Model.Any())
        {
            <div class="product-grid row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5">

                @foreach (var item in Model)
                {
                    <div class="col">

                        <div class="product-item">

                            @if (item.DiscountPrice.HasValue &&
                                 item.DiscountPrice.Value > 0 &&
                                 item.DiscountPrice.Value < item.Price)
                            {
                                var discountRate =
                                    Math.Round(
                                        (1 - (item.DiscountPrice.Value / item.Price)) * 100);

                                <span class="badge bg-success position-absolute m-3">
                                    -%@discountRate
                                </span>
                            }

                            <a href="#"
                               class="btn-wishlist">

                                <svg width="24" height="24">
                                    <use xlink:href="#heart"></use>
                                </svg>

                            </a>

                            <figure>

                                <a asp-controller="Product"
                                   asp-action="Detail"
                                   asp-route-id="@item.Id"
                                   title="@item.Name">

                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             alt="@item.Name"
                                             class="tab-image">
                                    }

                                </a>

                            </figure>

                            <h3>
                                @item.Name
                            </h3>

                            <span class="qty">
                                @item.CategoryName
                            </span>

                            @if (item.Stock > 0)
                            {
                                <span class="rating">
                                    <svg width="24"
                                         height="24"
                                         class="text-primary">

                                        <use xlink:href="#check-circle"></use>

                                    </svg>

                                    Stokta
                                </span>
                            }
                            else
                            {
                                <span class="rating text-danger">
                                    Stokta Yok
                                </span>
                            }

                            @if (item.DiscountPrice.HasValue &&
                                 item.DiscountPrice.Value > 0 &&
                                 item.DiscountPrice.Value < item.Price)
                            {
                                <div class="d-flex align-items-center gap-2 mb-3">

                                    <span class="price">
                                        @item.DiscountPrice.Value.ToString("N2") ₺
                                    </span>

                                    <span class="text-muted text-decoration-line-through">
                                        @item.Price.ToString("N2") ₺
                                    </span>

                                </div>
                            }
                            else
                            {
                                <span class="price">
                                    @item.Price.ToString("N2") ₺
                                </span>
                            }

                            @if (item.Stock > 0)
                            {
                                <div class="d-flex align-items-center justify-content-between">

                                    <div class="input-group product-qty">

                                        <span class="input-group-btn">

                                            <button type="button"
                                                    class="quantity-left-minus btn btn-danger btn-number"
                                                    data-type="minus">

                                                <svg width="16" height="16">
                                                    <use xlink:href="#minus"></use>
                                                </svg>

                                            </button>

                                        </span>

                                        <input type="text"
                                               name="quantity"
                                               class="form-control input-number"
                                               value="1"
                                               min="1"
                                               max="@item.Stock">

                                        <span class="input-group-btn">

                                            <button type="button"
                                                    class="quantity-right-plus btn btn-success btn-number"
                                                    data-type="plus">

                                                <svg width="16" height="16">
                                                    <use xlink:href="#plus"></use>
                                                </svg>

                                            </button>

                                        </span>

                                    </div>

                                    <a href="#"
                                       class="nav-link">

                                        Sepete Ekle

                                        <iconify-icon icon="uil:shopping-cart">
                                        </iconify-icon>

                                    </a>

                                </div>
                            }
                            else
                            {
                                <div class="mt-3">

                                    <button type="button"
                                            class="btn btn-secondary w-100"
                                            disabled>
                                        Stokta Yok
                                    </button>

                                </div>
                            }

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <h4>Henüz ürün bulunmuyor.</h4>

                <p class="text-muted">
                    Yeni ürünler eklendiğinde burada görüntülenecektir.
                </p>

            </div>
        }

    </div>
</section>