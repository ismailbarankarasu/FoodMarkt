@model string
<form asp-area="" asp-controller="Cart" asp-action="Add" method="post" class="add-to-cart-form mt-3">
    <input type="hidden" name="id" value="@Model" />
    <input type="hidden" name="quantity" value="1" />
    <input type="hidden" name="returnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" />
    <button type="submit" class="btn btn-primary w-100">Sepete Ekle</button>
</form>
